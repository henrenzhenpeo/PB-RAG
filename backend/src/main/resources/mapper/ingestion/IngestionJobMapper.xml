<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.pbrag.ingestion.mapper.IngestionJobMapper">
	<resultMap id="ingestionJobResultMap" type="dev.pbrag.ingestion.domain.IngestionJob">
		<id property="id" column="id"/>
		<result property="workspaceId" column="workspace_id"/>
		<result property="documentVersionId" column="document_version_id"/>
		<result property="status" column="status"/>
		<result property="stage" column="stage"/>
		<result property="attemptCount" column="attempt_count"/>
		<result property="maxAttempts" column="max_attempts"/>
		<result property="availableAt" column="available_at"/>
		<result property="leaseOwner" column="lease_owner"/>
		<result property="leaseExpiresAt" column="lease_expires_at"/>
		<result property="errorCode" column="error_code"/>
		<result property="errorMessage" column="error_message"/>
		<result property="createdAt" column="created_at"/>
		<result property="updatedAt" column="updated_at"/>
	</resultMap>

	<sql id="jobColumns">
		id, workspace_id, document_version_id, status, stage, attempt_count,
		max_attempts, available_at, lease_owner, lease_expires_at, error_code,
		error_message, created_at, updated_at
	</sql>

	<select id="selectByWorkspaceIdAndId" resultMap="ingestionJobResultMap">
		SELECT <include refid="jobColumns"/>
		FROM ingestion_jobs
		WHERE workspace_id = #{workspaceId} AND id = #{id}
	</select>

	<select id="selectByDocumentVersionId" resultMap="ingestionJobResultMap">
		SELECT <include refid="jobColumns"/>
		FROM ingestion_jobs
		WHERE document_version_id = #{documentVersionId}
	</select>
</mapper>
